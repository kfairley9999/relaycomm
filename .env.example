# Relaycomm configuration
RELAYCOMM_HOST=0.0.0.0
RELAYCOMM_PORT=8080
RELAYCOMM_DB_PATH=./relaycomm.db

# Default seeded development account (change in production!)
RELAYCOMM_ACCOUNT_SID=AC00000000000000000000000000000001
RELAYCOMM_AUTH_TOKEN=dev_auth_token_change_me

# Default carrier adapter: simulator | smtp_gateway | sip_stub | telnyx | vonage
RELAYCOMM_ADAPTER=simulator

# Base URL used when constructing resource URIs and callback URLs
RELAYCOMM_BASE_URL=http://localhost:8080

# Optional SMTP-to-SMS gateway settings (when RELAYCOMM_ADAPTER=smtp_gateway)
RELAYCOMM_SMTP_HOST=localhost
RELAYCOMM_SMTP_PORT=1025
RELAYCOMM_SMTP_USER=
RELAYCOMM_SMTP_PASSWORD=
RELAYCOMM_SMTP_FROM=relaycomm@example.local
RELAYCOMM_SMTP_USE_TLS=false
RELAYCOMM_SMTP_DEFAULT_CARRIER_DOMAIN=vtext.com

# Optional SIP / Asterisk ARI / FreeSWITCH stub settings
RELAYCOMM_SIP_ENGINE=asterisk_ari
RELAYCOMM_SIP_ENDPOINT=http://localhost:8088/ari
RELAYCOMM_SIP_TRUNK=trunk-primary

# Optional Telnyx / Vonage passthrough settings (never enabled unless selected)
RELAYCOMM_TELNYX_API_KEY=
RELAYCOMM_VONAGE_API_KEY=
RELAYCOMM_VONAGE_API_SECRET=
